NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Conexão com o Instagram (opcional; sem estas variáveis a tela oferece só a
# gravação de tela). Veja docs/INSTAGRAM.md. Nunca use NEXT_PUBLIC_ aqui.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Chave de 32 bytes em base64 para cifrar os tokens no banco. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Opcional: por padrão, NEXT_PUBLIC_SITE_URL + /api/instagram/callback
INSTAGRAM_REDIRECT_URI=
