{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vyrex: servidor local",
      "type": "process",
      "command": "C:\\Program Files\\nodejs\\npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "env": { "PATH": "C:\\Program Files\\nodejs;${env:PATH}" }
      },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^x{0}$" },
        "background": {
          "activesBegin": "next dev",
          "beginsPattern": "next dev",
          "endsPattern": "Ready in"
        }
      }
    }
  ]
}
